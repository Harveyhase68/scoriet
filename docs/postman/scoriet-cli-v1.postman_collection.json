    {
      "name": "🌐 System (Public)",
      "description": "Endpoints that work without authentication. Use these for smoke tests, version negotiation, and uptime monitoring.",
      "item": [
        {
          "name": "Health Check",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/system/health",
              "host": ["{{base_url}}"],
              "path": ["system", "health"]
            },
            "description": "Liveness probe. Returns 200 + `{status: healthy, timestamp}`. No auth, no DB query — useful for load balancers."
          }
        },
        {
          "name": "API Version",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/system/version",
              "host": ["{{base_url}}"],
              "path": ["system", "version"]
