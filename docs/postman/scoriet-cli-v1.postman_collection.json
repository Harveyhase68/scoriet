            "description": "Returns CLI binary version + API version + Scoriet app version. Used by clients to check compatibility before login."
          }
        }
      ]
    },
    {
      "name": "🔑 Auth",
      "description": "Login, logout, token refresh. **Start here.** The Login request auto-saves the token to {{cli_token}}.",
      "item": [
        {
          "name": "Login (authorize)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "// Every /cli/v1/* response is wrapped in the standard envelope —",
                  "// payload lives under json.data, not at the top level.",
                  "const data = json && json.data ? json.data : {};",
                  "",
                  "// 2FA challenge — store the two_factor_token for the verify-2fa request",
                  "if (data.two_factor_required && data.two_factor_token) {",
                  "    pm.collectionVariables.set('two_factor_token', data.two_factor_token);",
                  "    console.log('🔐 2FA required — two_factor_token saved. Run \"Verify 2FA\" next.');",
                  "    return;",
                  "}",
                  "",
                  "// Normal success — save the access token for all subsequent requests",
                  "if (json.success && data.token && data.token.access_token) {",
                  "    pm.collectionVariables.set('cli_token', data.token.access_token);",
                  "    console.log('✅ Token saved to {{cli_token}}, expires ' + data.token.expires_at);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\",\n  \"client_name\": \"Postman Test\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/authorize",
              "host": ["{{base_url}}"],
              "path": ["auth", "authorize"]
            },
            "description": "Issues a Personal Access Token. If 2FA is enabled, returns a `two_factor_token` instead — run **Verify 2FA** next.\n\nThrottled at 10 requests/minute per IP."
          }
        },
        {
          "name": "Verify 2FA (only if 2FA enabled)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data ? json.data : {};",
                  "if (json.success && data.token && data.token.access_token) {",
                  "    pm.collectionVariables.set('cli_token', data.token.access_token);",
                  "    console.log('✅ 2FA passed, token saved.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"two_factor_token\": \"{{two_factor_token}}\",\n  \"code\": \"123456\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/auth/verify-2fa",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify-2fa"]
            },
            "description": "Sends the 6-digit TOTP code (or 10-digit recovery code) plus the `two_factor_token` from the Login response. Issues the actual access token on success.\n\nAdditional optional fields: `trust_device` (boolean), `device_id` (string)."
          }
        },
        {
          "name": "Who am I",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/whoami",
              "host": ["{{base_url}}"],
              "path": ["auth", "whoami"]
            },
            "description": "Returns the authenticated user — great smoke-test after login to confirm the token works."
          }
        },
        {
          "name": "Verify token still valid",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/verify",
              "host": ["{{base_url}}"],
              "path": ["auth", "verify"]
            }
          }
        },
        {
          "name": "Check CLI access",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/cli-access",
              "host": ["{{base_url}}"],
              "path": ["auth", "cli-access"]
            },
            "description": "Returns whether the current user has a CLI subscription (required for most non-auth endpoints)."
          }
        },
        {
          "name": "Refresh token",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "const data = json && json.data ? json.data : {};",
                  "if (json.success && data.token && data.token.access_token) {",
                  "    pm.collectionVariables.set('cli_token', data.token.access_token);",
                  "    console.log('✅ Token refreshed.');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/refresh",
              "host": ["{{base_url}}"],
              "path": ["auth", "refresh"]
            },
            "description": "Revokes the current token and issues a fresh one. The new token replaces {{cli_token}} automatically."
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Accept", "value": "application/json" }
            ],
            "url": {
              "raw": "{{base_url}}/auth/logout",
              "host": ["{{base_url}}"],
              "path": ["auth", "logout"]
            },
            "description": "Revokes the current token. After this, {{cli_token}} will return 401 on every endpoint until you log in again."
          }
        }
      ]
    },
