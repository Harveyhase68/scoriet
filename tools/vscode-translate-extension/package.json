{
  "name": "scoriet-translate",
  "displayName": "Scoriet Translate Helper",
  "description": "Send selected text to WinDev translation tool",
  "version": "1.0.0",
  "publisher": "scoriet",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": ["Other"],
  "main": "./extension.js",
  "contributes": {
    "commands": [
      {
        "command": "scoriet-translate.translateSelection",
        "title": "Scoriet: Translate Selection"
      },
      {
        "command": "scoriet-translate.highlightLines",
        "title": "Scoriet: Highlight Lines from Clipboard"
      },
      {
        "command": "scoriet-translate.clearHighlights",
        "title": "Scoriet: Clear Line Highlights"
      },
      {
        "command": "scoriet-translate.nextHighlight",
        "title": "Scoriet: Next Highlight"
      },
      {
        "command": "scoriet-translate.prevHighlight",
        "title": "Scoriet: Previous Highlight"
      }
    ],
    "keybindings": [
      {
        "command": "scoriet-translate.translateSelection",
        "key": "ctrl+m",
        "when": "editorTextFocus && editorHasSelection"
      },
      {
        "command": "scoriet-translate.highlightLines",
        "key": "ctrl+shift+h",
        "when": "editorTextFocus"
      },
      {
        "command": "scoriet-translate.clearHighlights",
        "key": "ctrl+shift+j",
        "when": "editorTextFocus"
      },
      {
        "command": "scoriet-translate.nextHighlight",
        "key": "ctrl+shift+n",
        "when": "editorTextFocus"
      },
      {
        "command": "scoriet-translate.prevHighlight",
        "key": "ctrl+shift+b",
        "when": "editorTextFocus"
      }
    ],
    "configuration": {
      "title": "Scoriet Translate",
      "properties": {
        "scorietTranslate.apiUrl": {
          "type": "string",
          "default": "http://localhost:7777/i18n",
          "description": "URL of the WinDev translation REST API"
        },
        "scorietTranslate.highlightBackground": {
          "type": "string",
          "default": "rgba(255, 235, 59, 0.25)",
          "description": "Background color for highlighted lines (CSS color)"
        },
        "scorietTranslate.highlightBorder": {
          "type": "string",
          "default": "rgba(255, 235, 59, 0.6)",
          "description": "Left border color for highlighted lines (CSS color)"
        },
        "scorietTranslate.highlightGutterColor": {
          "type": "string",
          "default": "#FFEB3B",
          "description": "Overview ruler (minimap) color for highlighted lines"
        }
      }
    }
  }
}
